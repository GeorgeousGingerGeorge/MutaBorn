        {
            "m_Id": "b2cb5072d8c248bb8824f0f0687c5fef"
        },
        {
            "m_Id": "052f1ccb1801465fba7056a326b5587b"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ReconstructWorldPosition",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if UNITY_REVERSED_Z\r\n    float deviceDepth = Depth;\r\n#else\r\n    float deviceDepth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, Depth);\r\n#endif\r\n\r\nWorldPos = ComputeWorldSpacePosition(\r\n    UV,\r\n    deviceDepth,\r\n    UNITY_MATRIX_I_VP\r\n);\n"
}

