{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "21219055cc8e4d658135a13d14edd457",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SelectFloor (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -202.0,
            "y": 200.66668701171875,
            "width": 225.3333282470703,
            "height": 168.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b0e278372ac34f68aecf4a79df5d3580"
        },
        {
            "m_Id": "ccd64460e21b4d14952d7c72361d7904"
        },
        {
            "m_Id": "8922160baf034d23bb609d7c940f4a30"
        },
        {
            "m_Id": "944239eaea5d405c850d4b5e428a0710"
        },
        {
            "m_Id": "f90f6e34ee714745aa3d37c365647a85"
        },
        {
            "m_Id": "b68bf5ea7da04ce89a90d5712f289807"
        },
        {
            "m_Id": "46d99928bb5a4430ac95be3ce894f699"
        },
        {
            "m_Id": "e89c19191fae477da4b92b3403918196"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SelectFloor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\r\n#if UNITY_REVERSED_Z\r\n    float nearDepth = 1.0;\r\n    float farDepth = 0.0001;\r\n#else\r\n    float nearDepth = UNITY_NEAR_CLIP_VALUE;\r\n    float farDepth = 0.9999;\r\n#endif\r\n\r\nfloat3 rayStart = ComputeWorldSpacePosition(\r\n    UV,\r\n    nearDepth,\r\n    UNITY_MATRIX_I_VP\r\n);\r\n\r\nfloat3 rayEnd = ComputeWorldSpacePosition(\r\n    UV,\r\n    farDepth,\r\n    UNITY_MATRIX_I_VP\r\n);\r\n\r\nfloat3 rayDirection = normalize(rayEnd - rayStart);\r\n\r\nGridCoords = float2(0, 0);\r\nFloorIndex = 0;\r\nValid = 0;\nArraySize = float2(0,0);\r\n\r\nfloat surfaceDistance = dot(\r\n    WorldPos - rayStart,\r\n    rayDirection\r\n);\r\n\r\nfloat closestDistance = 1e20;\r\n\r\nif (abs(rayDirection.y) > 0.00001)\r\n{\r\n    for (int i = 0; i < (int)FloorCount; i++)\r\n    {\r\n        float4 originData = LOAD_TEXTURE2D(\r\n            _FloorMetaData,\r\n            int2(0, i)\r\n        );\r\n\r\n        float4 dimensionData = LOAD_TEXTURE2D(\r\n            _FloorMetaData,\r\n            int2(1, i)\r\n        );\r\n\r\n        float floorY = originData.g;\r\n\r\n        float intersectionDistance =\r\n            (floorY - rayStart.y) / rayDirection.y;\r\n\r\n        // The floor must be at or behind the visible surface.\r\n        if (intersectionDistance < surfaceDistance - 0.01)\r\n            continue;\r\n\r\n        if (intersectionDistance < 0)\r\n            continue;\r\n\r\n        float3 intersectionPoint =\r\n            rayStart + rayDirection * intersectionDistance;\r\n\r\n        float2 floorOriginXZ = float2(\r\n            originData.r,\r\n            originData.b\r\n        );\r\n\r\n        float2 relativePosition =\r\n            (intersectionPoint.xz - floorOriginXZ) / GridCellSize;\r\n\r\n        float2 gridPosition = floor(relativePosition + 0.5);\r\n\r\n        float floorWidth = dimensionData.r;\r\n        float floorHeight = dimensionData.g;\r\n\r\n        if (gridPosition.x < 0 ||\r\n            gridPosition.y < 0 ||\r\n            gridPosition.x >= floorWidth ||\r\n            gridPosition.y >= floorHeight)\r\n            continue;\r\n\r\n        if (intersectionDistance < closestDistance)\r\n        {\r\n            closestDistance = intersectionDistance;\r\n\r\n            GridCoords = gridPosition;\r\n            FloorIndex = originData.a;\r\n            Valid = 1;\n\t    ArraySize = dimensionData.ba;\r\n        }\r\n    }\r\n}\r\n\n"
}

