%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5628f016a51c4be296e54d65c4ecbc3f, type: 3}
  m_Name: ResourceDatabase
  m_EditorClassIdentifier: Assembly-CSharp::ResourceDatabase
  resources:
  - resourceID: gold
    resourceName: Gold
    description: A valuable metal used as the primary currency for trading goods and services. Shiny, universally desired, and somehow never available when you need it.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 0
  - resourceID: wood
    resourceName: Wood
    description: A common material harvested from trees. Used in construction, crafting, and various equipment. Surprisingly versatile for something that spends most of its life standing around.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: stone
    resourceName: Stone
    description: A naturally occurring solid material used for construction, crafting, and reinforcement. Abundant, durable, and exceptionally good at being heavy.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: copper
    resourceName: Copper
    description: A reddish-brown metal known for its flexibility and conductivity. Commonly used in tools, machinery, and various crafted components.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: iron
    resourceName: Iron
    description: A strong, widely available metal used in weapons, armor, tools, and construction. A reliable material that has been solving problems through blunt force for centuries.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: silver
    resourceName: Silver
    description: A valuable, reflective metal used in crafting, decoration, and specialized equipment. Tends to have negative effects to the unholy. More expensive than iron, but at least you can see yourself in it.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: textiles
    resourceName: Textiles
    description: Woven fibers, pelts, and fabrics used to create clothing, equipment, and various crafted materials. Essential for anyone who prefers not to enter battle completely naked.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: maana_crystals
    resourceName: Maana Crystals
    description: Crystalline formations containing magical energy. Used as a potential source of power for magical crafting and other applications.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 1
  - resourceID: gunpowder
    resourceName: Gunpowder
    description: A combustible material commonly used in firearms, explosives, and other explosive devices. Highly effective when used correctly. Highly effective when used incorrectly, too, just not in your favor.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 2
  - resourceID: gems
    resourceName: Gems
    description: Precious and semiprecious stones valued for their rarity and appearance. Often used in jewelry, specialized crafting, and potentially magical applications. A Goblins staple.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 2
  - resourceID: bones
    resourceName: Bones
    description: The hardened skeletal remains of living creatures. Useful for crafting and various specialized materials. The previous owner generally won't be asking for them back.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 2
  - resourceID: glass
    resourceName: Glass
    description: A hard, material typically produced by Elves heating and cooling unknown mineral substances. Useful for containers, lenses, and specialized equipment.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 2
  - resourceID: dvergrium
    resourceName: Dvergrium
    description: "(Dwer-Ghar-E-Um) meaning Metal of Dwarven Origin. Increadibly dense and heavy metal, a true reflection \nof the dwarves themselves. Sought after for its many uses but only Dwarves pass down the recipie. "
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 2
  - resourceID: steel
    resourceName: Steel
    description: A durable alloy primarily composed of iron and carbon. Stronger and more versatile than ordinary iron, making it valuable for advanced weapons, armor, and construction.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 3
  - resourceID: runes
    resourceName: Runes
    description: Symbols or inscriptions associated with magical properties. Their specific functions and applications depend on the magical principles used to create them. Instructions apparently sold separately.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 3
  - resourceID: mythical_lumber
    resourceName: Mythical Lumber
    description: An extraordinary form of timber associated with rare or magical sources. Potentially valuable for specialized construction and crafting. Your average backyard tree probably won't qualify.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 3
  - resourceID: enchanted_textiles
    resourceName: Enchanted Textiles
    description: Fabrics, pelts, or fibers  imbued with magical properties, offering capabilities beyond ordinary cloth. Finally, clothing that does something besides protect your dignity.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 3
  - resourceID: unstable_compound
    resourceName: Unstable Compound
    description: Compound harvested from those who have a mutant strain in their system, we are still unsure of the cause of our sudden mutations but we do know this is found in every case of mutation.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 4
  - resourceID: corrupt_nodule
    resourceName: Corrupt Nodule
    description: An abnormal growth seemingly comprised of the Unstable Compound with protiens and highly dense minerals giving varying atributes. These are the basis of most mutations in our systems.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 4
  - resourceID: mutated_heart
    resourceName: Mutated Heart
    description: The still bearting heart of a corrupt creature... The core of mutants in the late stages of development. Highly potent with Unstable Compound and Mana giving reason as to why mutants of this stage have such strength.
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 4
  - resourceID: mutantium
    resourceName: Mutantium
    description: 'A metal created from combining steel with a Corrupt Nodule, the corruption spreads into the ingot when introduced with high heats, once cooled we get a black sheen metal even tougher and better than the original alloy as long as you dont think about the fact its technically alive. '
    icon: {fileID: 21300000, guid: 79b4548d435ac484c859fcc2e251f862, type: 3}
    resourceType: 4
  - resourceID: sanguine_tears
    resourceName: Sanguine Tears
    description: A rare resource associated with MutaBorn enemies.
    icon: {fileID: 0}
    resourceType: 4
